   "source": [
    "# ── Plot 1: Payload attention mass by N × success ──────────────────────\n",
    "#\n",
    "# Violin plot for each N: distribution of mean_payload_attn for success vs fail.\n",
    "# Captures whether the decision boundary correlates with how much attention\n",
    "# the first reasoning token places on the attack payload.\n",
    "\n",
    "N_values = sorted(df_pert['perturbation_N'].dropna().unique())\n",
    "fig, axes = plt.subplots(1, len(N_values), figsize=(3 * len(N_values), 4), sharey=True)\n",
    "\n",
    "for ax, N in zip(axes, N_values):\n",
    "    sub = df_pert[df_pert['perturbation_N'] == N]\n",
    "    parts = ax.violinplot(\n",
    "        [sub[sub['success'] == False]['mean_payload'].values,\n",
    "         sub[sub['success'] == True]['mean_payload'].values],\n",
    "        positions=[0, 1], showmedians=True, showextrema=True\n",
    "    )\n",
    "    colors = ['#e74c3c', '#2ecc71']\n",
    "    for pc, c in zip(parts['bodies'], colors):\n",
    "        pc.set_facecolor(c)\n",
    "        pc.set_alpha(0.7)\n",
    "    ax.set_xticks([0, 1])\n",
    "    ax.set_xticklabels(['Fail', 'Pass'], fontsize=8)\n",
    "    ax.set_title(f'N={int(N)}', fontsize=9)\n",
    "    ax.set_xlim(-0.6, 1.6)\n",
    "\n",
    "axes[0].set_ylabel('Mean payload attention mass\\n(first reasoning token, all layers)')\n",
    "fig.suptitle('Payload attention mass: Success vs Failure by N (flips)', fontsize=11, y=1.02)\n",
    "plt.tight_layout()\n",
    "plt.savefig('attn_payload_violin_by_N.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
