    "# ── N=1 Plot B: Per-layer violin — payload attention per head ────────────\n",
    "#\n",
    "# One subplot per layer (24 total).\n",
    "# Each violin shows the distribution of per-head payload attention mass\n",
    "# for success (green) vs failure (red) runs.\n",
    "# This shows both the spread and the median — crucial for finding layers\n",
    "# where a subset of heads drives the decision boundary.\n",
    "\n",
    "grp   = 'payload'\n",
    "succ_arr = n1_mats[grp]['succ']   # (n_succ, N_LAYERS, N_HEADS)\n",
