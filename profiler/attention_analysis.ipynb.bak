   "source": [
    "# ── N=1 Plot A: Layer × Head heatmap per group (success | failure | Δ) ────\n",
    "#\n",
    "# One figure per span group.  Rows = heads (64), cols = layers (24).\n",
    "# Left panel: mean attention mass in success runs.\n",
    "# Middle panel: mean attention mass in failure runs.\n",
    "# Right panel: Δ = success − failure  (green=success pays more, red=failure pays more).\n",
    "# Local layers are marked with a dashed vertical line between the colourbar ticks.\n",
    "\n",
    "def _layer_ticks(ax, tick_every=4):\n",
    "    \"\"\"Set x-ticks at every `tick_every` layer, labelled with L/G annotation.\"\"\"\n",
    "    ticks  = list(range(0, N_LAYERS, tick_every))\n",
    "    labels = [LAYER_TICK_LABELS[i] for i in ticks]\n",
    "    ax.set_xticks(ticks)\n",
    "    ax.set_xticklabels(labels, fontsize=7)\n",
    "    # Shade local-layer columns lightly\n",
    "    for li in sorted(LOCAL_LAYERS):\n",
    "        ax.axvline(li - 0.5, color='steelblue', linewidth=0.3, alpha=0.4)\n",
    "\n",
    "\n",
    "for grp in list(SPAN_GROUPS.keys()) + ['sink']:\n",
    "    d = n1_mats[grp]\n",
    "    sm, fm = d['succ_mean'], d['fail_mean']\n",
    "    if sm is None or fm is None:\n",
    "        print(f'  {grp}: missing data, skipping')\n",
    "        continue\n",
    "    diff = sm - fm   # (N_LAYERS, N_HEADS)\n",
    "\n",
    "    vmax_s = sm.max()\n",
    "    vmax_f = fm.max()\n",
    "    vmax_d = np.abs(diff).max()\n",
    "\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(20, 9))\n",
    "    panels = [\n",
    "        (sm.T,   'YlOrRd',  0,       vmax_s, 'Success'),\n",
    "        (fm.T,   'YlOrRd',  0,       vmax_f, 'Failure'),\n",
    "        (diff.T, 'RdYlGn', -vmax_d,  vmax_d, 'Δ  (Success − Failure)'),\n",
    "    ]\n",
    "    for ax, (mat, cmap, vmin, vmax, title) in zip(axes, panels):\n",
    "        im = ax.imshow(mat, aspect='auto', cmap=cmap, vmin=vmin, vmax=vmax,\n",
    "                       interpolation='nearest', origin='lower')\n",
    "        ax.set_xlabel('Layer  (L=local  G=global)', fontsize=9)\n",
    "        ax.set_ylabel('Head', fontsize=9)\n",
    "        ax.set_title(title, fontsize=10)\n",
    "        _layer_ticks(ax)\n",
    "        plt.colorbar(im, ax=ax, fraction=0.03, pad=0.03)\n",
    "\n",
    "    fig.suptitle(f'[N=1]  Layer × Head  —  span group: {grp}', fontsize=12)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(f'n1_layerhead_{grp}.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()"
   ]
  },
