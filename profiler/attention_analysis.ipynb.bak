   ],
   "source": [
    "# ── Plot 2: Mean attention by span group, success vs failure, across N ──\n",
    "#\n",
    "# Line plot: x=N, y=mean attention mass, one line per group, split success/fail.\n",
    "# \"Mean attention mass\" = for each run: sum attention weights over span-group tokens\n",
    "# at the first reasoning token, averaged over heads, averaged over layers.\n",
    "# Annotated with per-N sample counts (n_success / n_failure).\n",
    "\n",
    "GROUPS_TO_PLOT = ['payload', 'user', 'system', 'tool_clean', 'frame']\n",
    "GROUP_COLORS   = {'payload': '#e74c3c', 'user': '#3498db', 'system': '#9b59b6',\n",
    "                  'tool_clean': '#f39c12', 'frame': '#95a5a6'}\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5), sharey=False)\n",
    "\n",
    "for ax, (success_val, title) in zip(axes, [(True, 'Success'), (False, 'Failure')]):\n",
    "    sub     = df_pert[df_pert['success'] == success_val]\n",
    "    grouped = sub.groupby('perturbation_N')[[f'mean_{g}' for g in GROUPS_TO_PLOT]].mean()\n",
    "    counts  = sub.groupby('perturbation_N').size()   # n samples per N\n",
    "\n",
    "    for grp in GROUPS_TO_PLOT:\n",
    "        ax.plot(grouped.index, grouped[f'mean_{grp}'],\n",
    "                'o-', color=GROUP_COLORS[grp], label=grp, linewidth=1.8, markersize=5)\n",
    "\n",
    "    # Annotate each N value with the sample count just above the x-axis\n",
    "    y_annot = ax.get_ylim()[0]   # will be updated after plotting; use transform instead\n",
    "    for N_val, n in counts.items():\n",
    "        ax.annotate(f'n={n}',\n",
    "                    xy=(N_val, 0), xycoords=('data', 'axes fraction'),\n",
    "                    xytext=(0, -26), textcoords='offset points',\n",
    "                    ha='center', va='top', fontsize=7, color='#555555')\n",
    "\n",
    "    ax.set_xlabel('N (tokens flipped)', fontsize=10, labelpad=22)\n",
    "    ax.set_ylabel('Mean attention mass\\n(∑ attn over span tokens, avg heads & layers)', fontsize=9)\n",
    "    ax.set_title(f'{title} runs', fontsize=11)\n",
    "    ax.set_xlim(left=0)\n",
    "    ax.set_ylim(bottom=0)\n",
    "    ax.legend(title='Span group', fontsize=8)\n",
    "\n",
    "fig.suptitle('Mean attention mass by span group and N — first reasoning token', fontsize=12)\n",
    "plt.tight_layout()\n",
    "plt.savefig('attn_by_group_N_success.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
