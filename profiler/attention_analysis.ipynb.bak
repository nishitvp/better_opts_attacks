    "# ── Plot 6: Layer profile — mean payload attention across layers, success vs failure\n",
    "#\n",
    "# For each N, plot mean payload attention per layer, with shaded bands for ±1 std.\n",
    "# Reveals which depth in the network the signal is strongest.\n",
    "\n",
    "ncols = 4\n",
    "nrows = int(np.ceil(len(N_values) / ncols))\n",
    "fig, axes = plt.subplots(nrows, ncols, figsize=(ncols * 4.5, nrows * 3.5), squeeze=False)\n",
    "\n",
    "for idx, N in enumerate(N_values):\n",
    "    ax = axes[idx // ncols][idx % ncols]\n",
    "\n",
    "    for success_val, color, label in [(True, '#2ecc71', 'Success'), (False, '#e74c3c', 'Failure')]:\n",
    "        run_ids = df_pert[(df_pert['perturbation_N'] == N) &\n",
    "                          (df_pert['success'] == success_val)]['run_id'].tolist()\n",
    "        mats = [per_layer_store[rid]['payload']\n",
    "                for rid in run_ids if rid in per_layer_store]\n",
    "        if not mats:\n",
    "            continue\n",
    "        min_len = min(len(m) for m in mats)\n",
    "        stacked = np.stack([m[:min_len] for m in mats], axis=0)  # (n_runs, n_layers)\n",
    "        mean = stacked.mean(axis=0)\n",
    "        std  = stacked.std(axis=0)\n",
    "        layers = np.arange(min_len)\n",
    "        ax.plot(layers, mean, color=color, label=label, linewidth=1.5)\n",
    "        ax.fill_between(layers, mean - std, mean + std, color=color, alpha=0.2)\n",
    "\n",
    "    ax.set_title(f'N={int(N)}', fontsize=9)\n",
    "    ax.set_xlabel('Layer', fontsize=8)\n",
    "    ax.set_ylabel('Payload attn mass', fontsize=8)\n",
    "    ax.legend(fontsize=7)\n",
    "\n",
    "for idx in range(len(N_values), nrows * ncols):\n",
    "    axes[idx // ncols][idx % ncols].set_visible(False)\n",
    "\n",
    "fig.suptitle('Payload attention per layer — success vs failure (shaded ±1σ)', fontsize=11)\n",
    "plt.tight_layout()\n",
    "plt.savefig('attn_payload_layer_profile.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
