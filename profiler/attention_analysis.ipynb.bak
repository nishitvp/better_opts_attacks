   ],
   "source": [
    "# ── Per-head attention mass helper (all layers, sink-aware) ─────────────\n",
    "#\n",
    "# load_head_matrices:   returns (n_runs, N_LAYERS, N_HEADS) for a span group.\n",
    "#                       Sink positions are excluded from all group masks.\n",
    "# load_sink_matrices:   same but mask covers only SINK_POSITIONS.\n",
    "\n",
    "def _build_span_mask(spans, seq_len, tag_set, exclude_positions=None):\n",
    "    mask = torch.zeros(seq_len, dtype=torch.bool)\n",
    "    for s in spans:\n",
    "        if s['tag'] in tag_set:\n",
    "            mask[s['start']:min(s['end'], seq_len)] = True\n",
    "    if exclude_positions:\n",
    "        for p in exclude_positions:\n",
    "            if p < seq_len:\n",
    "                mask[p] = False\n",
    "    return mask\n",
    "\n",
    "\n",
    "def load_head_matrices(run_ids, group):\n",
    "    \"\"\"\n",
    "    Load per-(layer, head) attention mass for `group` at the first reasoning token.\n",
    "\n",
    "    Returns np.array of shape (n_runs, N_LAYERS, N_HEADS).\n",
    "    Sink positions are excluded from the mask so their budget doesn't bleed in.\n",
    "    Runs with missing tensors are skipped silently.\n",
    "    \"\"\"\n",
    "    tag_set = SPAN_GROUPS[group]\n",
    "    mats = []\n",
    "    for rid in run_ids:\n",
    "        ci = cap_by_run.get(rid)\n",
    "        if ci is None:\n",
    "            continue\n",
    "        cap_path = TENSOR_BASE / ci['cap_path']\n",
    "        if not cap_path.exists():\n",
    "            continue\n",
    "        cap     = torch.load(cap_path, map_location='cpu', weights_only=False)\n",
    "        seq_len = cap['seq_len']\n",
    "        mask    = _build_span_mask(ci['spans'], seq_len, tag_set, SINK_POSITIONS)\n",
    "\n",
    "        layer_head_vals = []\n",
    "        for li in ALL_LAYERS:\n",
    "            if li not in cap['attention']:\n",
    "                layer_head_vals.append(np.full(N_HEADS, np.nan))\n",
    "                continue\n",
    "            a  = cap['attention'][li]            # (heads, n_pos, klen)\n",
    "            a0 = a[:, 0, :].float()              # (heads, klen)\n",
    "            m  = mask[:a0.shape[-1]].float()\n",
    "            mass = (a0 * m.unsqueeze(0)).sum(-1) # (heads,)\n",
    "            layer_head_vals.append(mass.numpy())\n",
    "\n",
    "        mats.append(np.stack(layer_head_vals, axis=0))  # (n_layers, n_heads)\n",
    "\n",
    "    return np.stack(mats, axis=0) if mats else None      # (n_runs, n_layers, n_heads)\n",
    "\n",
    "\n",
    "def load_sink_matrices(run_ids):\n",
    "    \"\"\"Returns (n_runs, N_LAYERS, N_HEADS) with mass on SINK_POSITIONS only.\"\"\"\n",
    "    mats = []\n",
    "    for rid in run_ids:\n",
    "        ci = cap_by_run.get(rid)\n",
    "        if ci is None:\n",
    "            continue\n",
    "        cap_path = TENSOR_BASE / ci['cap_path']\n",
    "        if not cap_path.exists():\n",
    "            continue\n",
    "        cap     = torch.load(cap_path, map_location='cpu', weights_only=False)\n",
    "        seq_len = cap['seq_len']\n",
    "        mask    = _build_span_mask([], seq_len, set())   # start empty\n",
    "        for p in SINK_POSITIONS:\n",
    "            if p < seq_len:\n",
    "                mask[p] = True\n",
    "\n",
    "        layer_head_vals = []\n",
    "        for li in ALL_LAYERS:\n",
    "            if li not in cap['attention']:\n",
    "                layer_head_vals.append(np.full(N_HEADS, np.nan))\n",
    "                continue\n",
    "            a  = cap['attention'][li]\n",
    "            a0 = a[:, 0, :].float()\n",
    "            m  = mask[:a0.shape[-1]].float()\n",
    "            mass = (a0 * m.unsqueeze(0)).sum(-1)\n",
    "            layer_head_vals.append(mass.numpy())\n",
    "        mats.append(np.stack(layer_head_vals, axis=0))\n",
    "\n",
    "    return np.stack(mats, axis=0) if mats else None\n",
    "\n",
    "\n",
    "print('Helpers defined: load_head_matrices, load_sink_matrices')"
   ]
  },
