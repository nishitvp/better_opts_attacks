   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Attention Pattern Analysis: Success vs Failure at the Decision Boundary\n",
    "\n",
    "Analyzes attention patterns at the **first reasoning token** across success/failure runs,\n",
    "stratified by perturbation N (number of tokens flipped).\n",
    "\n",
    "Data: `profiling_logs_v3/` — flip perturbations, 671 captures total.\n",
    "\n",
    "Key groupings:\n",
    "- `attack_payload` — the injected payload tokens\n",
    "- `user_instruction` — user task tokens\n",
    "- `system_meta` + `developer_tools` — system prompt tokens\n",
    "- `tool_env_data` — tool response content (non-payload environment data)\n",
    "- `frame_*` — harmony structural/control tokens"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Config ready.\n"
     ]
    }
   ],
   "source": [
    "import sys, pickle, sqlite3, json\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.cm as cm\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "from collections import defaultdict\n",
    "\n",
    "sns.set_theme(style='whitegrid', font_scale=0.95)\n",
    "\n",
    "# ── Config ───────────────────────────────────────────────────────────────\n",
    "LOG_DIR  = Path('profiling_logs_v3')\n",
    "DB_PATH  = LOG_DIR / 'experiment_logs.db'\n",
    "# Stored cap_paths are relative to the profiler/ dir (e.g. \"profiling_logs_v3/tensors/<id>_cap.pt\")\n",
    "# so we just prepend Path('.') to resolve them correctly.\n",
    "TENSOR_BASE = Path('.')\n",
    "\n",
    "# Span groups we care about (fine-grained tags from conversation_tagger)\n",
    "SPAN_GROUPS = {\n",
    "    'payload':    {'attack_payload', 'attack_prefix', 'attack_suffix'},\n",
    "    'user':       {'user_instruction'},\n",
    "    'system':     {'system_meta', 'developer_instructions', 'developer_tools'},\n",
    "    'tool_clean': {'tool_env_data'},\n",
    "    'frame':      {'frame_boundary', 'frame_message', 'frame_role',\n",
    "                   'frame_channel', 'frame_channel_name',\n",
    "                   'frame_constrain', 'frame_constrain_type', 'frame_metadata'},\n",
    "}\n",
    "\n",
    "print('Config ready.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Runs loaded:    1442\n",
      "Captures loaded:671\n"
     ]
    }
   ],
   "source": [
    "# ── Load all runs + captures from SQLite ────────────────────────────────\n",
    "\n",
    "conn = sqlite3.connect(DB_PATH)\n",
    "cur  = conn.cursor()\n",
    "\n",
    "# All profiling runs\n",
    "cur.execute(\"SELECT metadata_json FROM logs WHERE event='profiling_run'\")\n",
    "runs_meta = {json.loads(r[0])['run_id']: json.loads(r[0]) for r in cur.fetchall()}\n",
    "\n",
    "# All profiling captures (tensor path + spans)\n",
    "cur.execute(\"SELECT metadata_json, object_data FROM logs WHERE event='profiling_capture'\")\n",
    "cap_rows = cur.fetchall()\n",
    "conn.close()\n",
    "\n",
    "cap_by_run = {}  # run_id → cap_info dict\n",
    "for meta_json, obj_data in cap_rows:\n",
    "    meta    = json.loads(meta_json)\n",
    "    cap_info = pickle.loads(obj_data)\n",
    "    cap_by_run[meta['run_id']] = cap_info\n",
    "\n",
    "print(f'Runs loaded:    {len(runs_meta)}')\n",
    "print(f'Captures loaded:{len(cap_by_run)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Helper defined.\n"
     ]
    }
   ],
   "source": [
    "# ── Helper: compute attention mass for a single capture ─────────────────\n",
    "\n",
    "def spans_to_mask(spans, seq_len, tag_set):\n",
    "    \"\"\"Boolean mask over [0, seq_len) covering all spans whose tag is in tag_set.\"\"\"\n",
    "    mask = torch.zeros(seq_len, dtype=torch.bool)\n",
    "    for s in spans:\n",
    "        if s['tag'] in tag_set:\n",
    "            mask[s['start']:min(s['end'], seq_len)] = True\n",
    "    return mask\n",
    "\n",
    "\n",
    "def attention_mass_first_token(cap, spans):\n",
    "    \"\"\"\n",
    "    For every layer, extract attention FROM the first reasoning token (pos 0 in the\n",
    "    captured positions) TO each span group.\n",
    "\n",
    "    cap[\"attention\"][layer] shape: (num_heads, n_reasoning_tokens, seq_len)\n",
    "\n",
    "    Returns dict:\n",
    "        {\n",
    "          group_name: {\n",
    "              'per_layer': np.array([n_layers])  — mean across heads,\n",
    "              'per_layer_per_head': np.array([n_layers, n_heads]),\n",
    "              'mean': float  — mean across layers & heads,\n",
    "          }\n",
    "        }\n",
    "    \"\"\"\n",
    "    seq_len = cap['seq_len']\n",
    "    attn    = cap['attention']   # {layer_idx: tensor(heads, n_pos, klen)}\n",
    "    layers  = sorted(attn.keys())\n",
    "\n",
    "    # Pre-build masks\n",
    "    masks = {grp: spans_to_mask(spans, seq_len, tags)\n",
    "             for grp, tags in SPAN_GROUPS.items()}\n",
    "\n",
    "    result = {grp: {'per_layer': [], 'per_layer_per_head': []} for grp in SPAN_GROUPS}\n",
    "\n",
    "    for layer_idx in layers:\n",
    "        a = attn[layer_idx]   # (heads, n_pos, klen)\n",
    "        if a.dim() != 3:\n",
    "            continue\n",
    "        a0 = a[:, 0, :]       # (heads, klen) — first reasoning token only\n",
    "\n",
    "        for grp, mask in masks.items():\n",
    "            m = mask[:a0.shape[-1]].float()   # align klen\n",
    "            mass_per_head = (a0 * m.unsqueeze(0)).sum(dim=-1)  # (heads,)\n",
    "            result[grp]['per_layer'].append(mass_per_head.mean().item())\n",
    "            result[grp]['per_layer_per_head'].append(mass_per_head.numpy())\n",
    "\n",
    "    for grp in result:\n",
    "        pl = np.array(result[grp]['per_layer'])   # (n_layers,)\n",
    "        ph = np.array(result[grp]['per_layer_per_head'])  # (n_layers, heads)\n",
    "        result[grp]['per_layer'] = pl\n",
    "        result[grp]['per_layer_per_head'] = ph\n",
    "        result[grp]['mean'] = float(pl.mean()) if len(pl) else np.nan\n",
    "\n",
    "    return result\n",
    "\n",
    "print('Helper defined.')"
   ]
  },
