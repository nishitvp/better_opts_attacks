   ],
   "source": [
    "# ── Architecture constants ───────────────────────────────────────────────\n",
    "# Even layers have last-256-token fraction ≈ 1.0 → sliding-window (local).\n",
    "# Odd layers spread across the full sequence → global.\n",
    "# NOTE: the payload always falls within the local window, so ALL 24 layers\n",
    "# can attend to it.  Local/global is used only as an annotation on plots.\n",
    "\n",
    "N_LAYERS      = 24\n",
    "N_HEADS       = 64\n",
    "LOCAL_LAYERS  = set(range(0, N_LAYERS, 2))   # 0,2,4,...,22  (local/sliding-window)\n",
    "GLOBAL_LAYERS = set(range(1, N_LAYERS, 2))   # 1,3,5,...,23  (full-context)\n",
    "ALL_LAYERS    = sorted(LOCAL_LAYERS | GLOBAL_LAYERS)\n",
    "\n",
    "# Position 0 is an attention sink (visible only in global layers).\n",
    "# Track its mass separately; exclude it from all span-group masks.\n",
    "SINK_POSITIONS = {0}\n",
    "\n",
    "# x-axis tick labels for plots: mark local (L) and global (G) layers\n",
    "LAYER_TICK_LABELS = [f'{i}\\n{\"L\" if i in LOCAL_LAYERS else \"G\"}' for i in ALL_LAYERS]\n",
    "\n",
    "print(f'Local  layers ({len(LOCAL_LAYERS)}): {sorted(LOCAL_LAYERS)}')\n",
    "print(f'Global layers ({len(GLOBAL_LAYERS)}): {sorted(GLOBAL_LAYERS)}')\n",
    "print(f'Sink positions: {SINK_POSITIONS}')\n",
    "\n",
    "# ── N=1 subset ────────────────────────────────────────────────────────────\n",
    "df_n1 = df_pert[df_pert['perturbation_N'] == 1.0].copy()\n",
    "print(f'\\nN=1 rows: {len(df_n1)}  '\n",
    "      f'(success={df_n1[\"success\"].sum()}, failure={(~df_n1[\"success\"]).sum()})')"
   ]
  },
  {
   "cell_type": "markdown",
