   ],
   "source": [
    "# ── Plot 3: Payload attention difference (Success − Failure) by N and Layer\n",
    "#\n",
    "# For each (N, layer), compute mean payload attention mass for success runs\n",
    "# minus mean for failure runs.  Shows which layers drive the gap.\n",
    "\n",
    "# Collect per-layer data\n",
    "layer_rows = []\n",
    "for run_id, grp_layers in per_layer_store.items():\n",
    "    run = runs_meta.get(run_id)\n",
    "    if run is None or run.get('source') != 'perturbation':\n",
    "        continue\n",
    "    payload_per_layer = grp_layers['payload']  # np.array (n_layers,)\n",
    "    for layer_idx, val in enumerate(payload_per_layer):\n",
    "        layer_rows.append({\n",
    "            'run_id':   run_id,\n",
    "            'N':        run.get('perturbation_N'),\n",
    "            'success':  bool(run.get('success')),\n",
    "            'layer':    layer_idx,\n",
    "            'payload_attn': float(val),\n",
    "        })\n",
    "\n",
    "df_layer = pd.DataFrame(layer_rows)\n",
    "\n",
    "# Pivot: mean payload attn per (N, layer, success)\n",
    "pivot = df_layer.groupby(['N', 'layer', 'success'])['payload_attn'].mean().unstack('success')\n",
    "pivot.columns = [False, True]\n",
    "pivot['diff'] = pivot[True] - pivot[False]  # success − failure\n",
    "pivot = pivot.reset_index()\n",
    "\n",
    "# One heatmap per N\n",
    "N_vals = sorted(df_layer['N'].dropna().unique())\n",
    "n_layers = df_layer['layer'].max() + 1\n",
    "\n",
    "ncols = 4\n",
    "nrows = int(np.ceil(len(N_vals) / ncols))\n",
    "fig, axes = plt.subplots(nrows, ncols, figsize=(ncols * 4, nrows * 3.5), squeeze=False)\n",
    "\n",
    "vmax = pivot['diff'].abs().quantile(0.95)\n",
    "\n",
    "for idx, N in enumerate(N_vals):\n",
    "    ax = axes[idx // ncols][idx % ncols]\n",
    "    sub = pivot[pivot['N'] == N].sort_values('layer')\n",
    "    ax.bar(sub['layer'], sub['diff'],\n",
    "           color=[('#2ecc71' if v > 0 else '#e74c3c') for v in sub['diff']],\n",
    "           width=0.8, alpha=0.8)\n",
    "    ax.axhline(0, color='black', linewidth=0.7)\n",
    "    ax.set_title(f'N={int(N)}', fontsize=9)\n",
    "    ax.set_xlabel('Layer', fontsize=7)\n",
    "    ax.set_ylabel('Δ payload attn\\n(succ − fail)', fontsize=7)\n",
    "    ax.set_ylim(-vmax * 1.2, vmax * 1.2)\n",
    "\n",
    "# Hide unused subplots\n",
    "for idx in range(len(N_vals), nrows * ncols):\n",
    "    axes[idx // ncols][idx % ncols].set_visible(False)\n",
    "\n",
    "fig.suptitle('Payload attention Δ (success − failure) per layer, by N\\n'\n",
    "             'Green = success attends MORE to payload', fontsize=11)\n",
    "plt.tight_layout()\n",
    "plt.savefig('attn_payload_delta_by_layer_N.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Plot 4: Head-level heatmap — payload attention for success vs failure\n",
    "#\n",
    "# For a single N (or pooled over N), show a (layer × head) heatmap of mean\n",
    "# payload attention mass, side by side for success and failure.\n",
    "# Highlights specific (layer, head) pairs that encode injection.\n",
    "\n",
    "def build_layer_head_matrix(run_ids, group='payload'):\n",
    "    \"\"\"Returns (n_layers, n_heads) mean attention matrix.\"\"\"\n",
    "    mats = []\n",
    "    for rid in run_ids:\n",
    "        ph = per_layer_head_store.get(rid, {}).get(group)\n",
    "        if ph is not None and len(ph) > 0:\n",
    "            mats.append(ph)  # (n_layers, n_heads)\n",
    "    if not mats:\n",
    "        return None\n",
    "    # Align shapes (all should be identical, but guard just in case)\n",
    "    min_layers = min(m.shape[0] for m in mats)\n",
    "    min_heads  = min(m.shape[1] for m in mats)\n",
    "    stacked = np.stack([m[:min_layers, :min_heads] for m in mats], axis=0)\n",
    "    return stacked.mean(axis=0)  # (n_layers, n_heads)\n",
    "\n",
    "\n",
    "# Aggregate over all N (pooled view)\n",
    "pert_ids_success = df_pert[df_pert['success'] == True]['run_id'].tolist()\n",
    "pert_ids_failure = df_pert[df_pert['success'] == False]['run_id'].tolist()\n",
    "\n",
    "mat_succ = build_layer_head_matrix(pert_ids_success, 'payload')\n",
    "mat_fail = build_layer_head_matrix(pert_ids_failure, 'payload')\n",
    "mat_diff = mat_succ - mat_fail\n",
    "\n",
    "vmax_abs = np.abs(mat_diff).max()\n",
    "cmap_div = 'RdYlGn'\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(20, 7))\n",
    "titles = ['Success (mean payload attn)', 'Failure (mean payload attn)', 'Δ = Success − Failure']\n",
    "mats   = [mat_succ, mat_fail, mat_diff]\n",
    "cmaps  = ['YlOrRd', 'YlOrRd', cmap_div]\n",
    "vranges = [(0, mat_succ.max()), (0, mat_fail.max()), (-vmax_abs, vmax_abs)]\n",
    "\n",
    "for ax, mat, title, cmap, (vmin, vmax) in zip(axes, mats, titles, cmaps, vranges):\n",
    "    im = ax.imshow(mat.T, aspect='auto', cmap=cmap, vmin=vmin, vmax=vmax,\n",
    "                   interpolation='nearest', origin='lower')\n",
    "    ax.set_xlabel('Layer', fontsize=10)\n",
    "    ax.set_ylabel('Head', fontsize=10)\n",
    "    ax.set_title(title, fontsize=10)\n",
    "    plt.colorbar(im, ax=ax, fraction=0.046, pad=0.04)\n",
    "\n",
    "fig.suptitle('Layer × Head payload attention mass (first reasoning token, all N pooled)',\n",
    "             fontsize=12)\n",
    "plt.tight_layout()\n",
    "plt.savefig('attn_layer_head_heatmap.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
