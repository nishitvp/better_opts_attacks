    "# ── N=1 Plot C: Attention budget per span group, per layer — success vs failure ─\n",
    "#\n",
    "# Stacked bar chart: for each layer, show how attention mass is split across\n",
    "# span groups (payload, user, system, tool_clean, frame, sink).\n",
    "# Two bars per layer: left=success, right=failure.\n",
    "# Reveals whether successful injection changes the attention budget allocation.\n",
    "\n",
    "BUDGET_GROUPS  = ['payload', 'user', 'system', 'tool_clean', 'frame', 'sink']\n",
    "BUDGET_COLORS  = {\n",
    "    'payload':    '#e74c3c',\n",
    "    'user':       '#3498db',\n",
    "    'system':     '#9b59b6',\n",
    "    'tool_clean': '#f39c12',\n",
    "    'frame':      '#95a5a6',\n",
    "    'sink':       '#1abc9c',\n",
    "}\n",
    "\n",
    "# Per-layer mean across heads and runs\n",
    "# succ_means[grp] shape: (N_LAYERS,)\n",
    "succ_means = {grp: n1_mats[grp]['succ_mean'].mean(axis=-1) for grp in BUDGET_GROUPS\n",
    "              if n1_mats[grp]['succ_mean'] is not None}\n",
    "fail_means = {grp: n1_mats[grp]['fail_mean'].mean(axis=-1) for grp in BUDGET_GROUPS\n",
    "              if n1_mats[grp]['fail_mean'] is not None}\n",
    "\n",
    "x    = np.arange(N_LAYERS)\n",
    "w    = 0.38   # bar half-width\n",
    "fig, ax = plt.subplots(figsize=(22, 5))\n",
    "\n",
    "bottom_s = np.zeros(N_LAYERS)\n",
    "bottom_f = np.zeros(N_LAYERS)\n",
    "for grp in BUDGET_GROUPS:\n",
    "    if grp not in succ_means:\n",
    "        continue\n",
    "    sv = succ_means[grp]\n",
    "    fv = fail_means[grp]\n",
    "    ax.bar(x - w/2, sv, width=w, bottom=bottom_s,\n",
    "           color=BUDGET_COLORS[grp], label=grp, alpha=0.85)\n",
    "    ax.bar(x + w/2, fv, width=w, bottom=bottom_f,\n",
    "           color=BUDGET_COLORS[grp], alpha=0.50)   # faded = failure\n",
    "    bottom_s += sv\n",
    "    bottom_f += fv\n",
    "\n",
    "# Annotate local (L) / global (G)\n",
    "for li in ALL_LAYERS:\n",
    "    ltype = 'L' if li in LOCAL_LAYERS else 'G'\n",
    "    ax.text(li, -0.008, ltype, ha='center', va='top', fontsize=6, color='steelblue')\n",
    "\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels([str(i) for i in ALL_LAYERS], fontsize=7)\n",
    "ax.set_xlabel('Layer  (L=local  G=global, shown below axis)', fontsize=9)\n",
    "ax.set_ylabel('Mean attention mass (head-averaged)', fontsize=9)\n",
    "ax.set_title('[N=1]  Attention budget per span group per layer\\n'\n",
    "             'Solid bar = Success,  Faded bar = Failure', fontsize=11)\n",
    "ax.legend(title='Span group', bbox_to_anchor=(1.01, 1), loc='upper left', fontsize=8)\n",
    "plt.tight_layout()\n",
    "plt.savefig('n1_budget_stacked.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
