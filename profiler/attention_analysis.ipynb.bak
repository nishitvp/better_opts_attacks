   "source": [
    "# ── Build the flat dataframe ─────────────────────────────────────────────\n",
    "#\n",
    "# One row per run-with-capture.  Columns:\n",
    "#   run_id, source, success, perturbation_N, perturbation_position\n",
    "#   + mean_<group> for each span group\n",
    "#   + per_layer data stored in side-dicts (avoids DataFrame object-dtype columns)\n",
    "\n",
    "records = []\n",
    "per_layer_store      = {}   # run_id → {group: np.array(n_layers)}\n",
    "per_layer_head_store = {}   # run_id → {group: np.array(n_layers, n_heads)}\n",
    "\n",
    "missing_tensor = 0\n",
    "for run_id, cap_info in cap_by_run.items():\n",
    "    run = runs_meta.get(run_id)\n",
    "    if run is None:\n",
    "        continue\n",
    "\n",
    "    cap_path = TENSOR_BASE / cap_info['cap_path']\n",
    "    if not cap_path.exists():\n",
    "        missing_tensor += 1\n",
    "        continue\n",
    "\n",
    "    cap   = torch.load(cap_path, map_location='cpu', weights_only=False)\n",
    "    spans = cap_info['spans']\n",
    "    masses = attention_mass_first_token(cap, spans)\n",
    "\n",
    "    row = {\n",
    "        'run_id':                run_id,\n",
    "        'source':                run.get('source'),\n",
    "        'success':               bool(run.get('success')),\n",
    "        'perturbation_N':        run.get('perturbation_N'),\n",
    "        'perturbation_position': run.get('perturbation_position'),\n",
    "        'suite':                 run.get('suite'),\n",
    "        'user_task_id':          run.get('user_task_id'),\n",
    "    }\n",
    "    for grp in SPAN_GROUPS:\n",
    "        row[f'mean_{grp}'] = masses[grp]['mean']\n",
    "\n",
    "    records.append(row)\n",
    "    per_layer_store[run_id]      = {grp: masses[grp]['per_layer']          for grp in SPAN_GROUPS}\n",
    "    per_layer_head_store[run_id] = {grp: masses[grp]['per_layer_per_head'] for grp in SPAN_GROUPS}\n",
    "\n",
    "df      = pd.DataFrame(records)\n",
    "df_pert = df[df['source'] == 'perturbation'].copy()\n",
    "\n",
    "print(f'Total rows:        {len(df)}')\n",
    "print(f'Perturbation rows: {len(df_pert)}')\n",
    "print(f'Missing tensors:   {missing_tensor}')\n",
    "df_pert.groupby(['perturbation_N', 'success']).size().unstack(fill_value=0)"
   ]
  },
  {
